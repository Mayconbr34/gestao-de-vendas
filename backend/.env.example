# Servidor
PORT=3001
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Banco de dados (PostgreSQL)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SYNC=false

# Autenticação JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Frontend (usado em links de reset de senha, etc.)
FRONTEND_URL=http://localhost:3000

# Upload de arquivos
UPLOAD_DIR=uploads

# Geolocalização de IP (opcional)
GEOIP_API_URL=https://ipapi.co/{ip}/json/

# Chaves de API
API_RATE_LIMIT_DEFAULT=60
